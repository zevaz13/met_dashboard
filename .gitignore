# Data -- the folder structure is tracked (README.md placeholders below),
# actual data (raw or derived, real or test) is never committed.
data/**
!data/**/
!data/**/README.md

# Data intake inbox -- the folder is tracked so it always exists, but files
# dropped into it (new subject data, awaiting the Data Intake page) are not.
updateData/*
!updateData/README.md
